---
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container site-footer__inner">
    <div class="site-footer__brand">
      <p class="site-footer__name">Matt Warnock</p>
      <p class="site-footer__tag">Fantasy &amp; adventure fiction.</p>
    </div>

    <nav class="site-footer__nav" aria-label="Footer">
      <a href="/about">About</a>
      <a href="/publications">Publications</a>
      <a href="/blog">Journal</a>
      <a href="/contact">Contact</a>
    </nav>
  </div>

  <div class="container site-footer__base">
    <p>&copy; {year} Matt Warnock. All rights reserved.</p>
  </div>
</footer>

<style>
  .site-footer {
    margin-top: auto;
    border-top: 1px solid var(--rule);
    background: var(--paper-deep);
  }
  .site-footer__inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    padding-block: 2.6rem;
  }
  .site-footer__name {
    font-family: var(--font-display);
    font-size: 1.3rem;
    margin: 0;
  }
  .site-footer__tag {
    margin: 0.3rem 0 0;
    color: var(--ink-faint);
    font-size: 0.95rem;
  }
  .site-footer__nav {
    display: flex;
    flex-wrap: wrap;
    gap: 1.6rem;
  }
  .site-footer__nav a {
    color: var(--ink-soft);
    text-decoration: none;
    font-size: 0.95rem;
  }
  .site-footer__nav a:hover { color: var(--burgundy); }
  .site-footer__base {
    border-top: 1px solid var(--rule);
    padding-block: 1.2rem;
  }
  .site-footer__base p {
    margin: 0;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }
</style>
