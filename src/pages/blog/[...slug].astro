---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection, render } from "astro:content";

export async function getStaticPaths() {
  const posts = await getCollection("blog", ({ data }) => !data.draft);
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post },
  }));
}

const { post } = Astro.props;
const { Content } = await render(post);

const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-US", { month: "long", day: "numeric", year: "numeric" });

const articleSchema = {
  "@context": "https://schema.org",
  "@type": "BlogPosting",
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { "@type": "Person", name: "Matt Warnock" },
};
---

<BaseLayout
  title={`${post.data.title} — Matt Warnock`}
  description={post.data.description}
  ogType="article"
>
  <script
    slot="head"
    type="application/ld+json"
    set:html={JSON.stringify(articleSchema)}
  />

  <article class="section">
    <div class="container container--narrow">
      <p class="post-back"><a href="/blog">&larr; All entries</a></p>

      <header class="post-header">
        <time datetime={post.data.pubDate.toISOString()}>
          {dateFmt(post.data.pubDate)}
        </time>
        <h1>{post.data.title}</h1>
      </header>

      <div class="prose post-body">
        <Content />
      </div>

      <footer class="post-footer">
        <p class="ornament"><span>✦</span></p>
        <p>
          Thanks for reading. <a href="/contact">Drop Matt a line</a> or browse
          <a href="/publications">his publications</a>.
        </p>
      </footer>
    </div>
  </article>
</BaseLayout>

<style>
  .post-back { font-size: 0.95rem; }
  .post-header { margin: 1.5rem 0 2.5rem; }
  .post-header time {
    font-size: 0.8rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }
  .post-header h1 { margin-top: 0.6rem; }
  .post-body :global(h2) { margin-top: 1.8em; }
  .post-body :global(img) { border-radius: var(--radius); margin-block: 1.6em; }
  .post-footer { margin-top: 3rem; padding-top: 2rem; border-top: 1px solid var(--rule); }
  .post-footer .ornament { max-width: 8rem; margin: 0 0 1.4rem; }
  .post-footer p { color: var(--ink-soft); }
</style>
