---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="About Matt Warnock"
  description="Get to know Matt Warnock — author of The Traveling Jessie Barstow and a growing collection of fantasy and adventure short stories."
>
  <section class="section">
    <div class="container container--narrow">
      <p class="kicker">About</p>
      <h1>About Matt</h1>

      <div class="about__lead">
        <div class="about__portrait"><img src="/matt-portrait.jpg" width="900" height="900" alt="Matt Warnock" loading="lazy" decoding="async" /></div>
        <div class="prose">
          <p>
            Matt Warnock writes across a spectrum of speculative fiction.
            <em>The Traveling Jessie Barstow</em> is his debut novel. He has had
            micro-fiction appear in Vine Leaves Press <em>50 Give or Take</em>,
            <em>50 Word Stories</em>, and <em>Ossuary 13</em>.
          </p>
          <p>
            Matt is a lifelong resident of Illinois, where he lives with his wife,
            children, and their dogs. When not writing, he enjoys hiking, gardening,
            and too many hobbies.
          </p>
        </div>
      </div>

      <blockquote class="about__quote prose">
        <p>
          "I write the kind of stories I wanted to disappear into as a kid — the ones
          where the next page might open onto an entirely different world."
        </p>
        <cite>— Matt Warnock</cite>
      </blockquote>

      <p class="prose about__cta">
        Want to reach out about an event, an interview, or just to say hello?
        <a href="/contact">Send Matt a message.</a>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .about__lead {
    display: grid;
    grid-template-columns: 9rem 1fr;
    gap: clamp(1.5rem, 1rem + 3vw, 3rem);
    align-items: start;
    margin-top: 2rem;
  }
  .about__portrait {
    aspect-ratio: 1;
    border-radius: 50%;
    background: radial-gradient(120% 120% at 30% 20%, #8a3441, #5d1f29);
    color: #efddc2;
    display: grid;
    place-items: center;
    font-family: var(--font-display);
    font-size: 2.4rem;
    box-shadow: inset 0 0 0 1px rgba(208, 174, 110, 0.4),
      0 18px 30px -20px rgba(33, 27, 23, 0.6);
  }
  .placeholder-note {
    color: var(--burgundy);
    font-style: italic;
    background: rgba(124, 45, 58, 0.07);
    padding: 0 0.25em;
  }
  .about__quote {
    margin: 2.6rem 0;
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1.1rem + 1.2vw, 1.9rem);
    line-height: 1.3;
    border-left: 3px solid var(--burgundy);
    padding-left: 1.4rem;
    color: var(--ink);
  }
  .about__quote p { margin-bottom: 0.6rem; }
  .about__quote cite {
    font-family: var(--font-body);
    font-style: normal;
    font-size: 1rem;
    color: var(--ink-faint);
  }
  .about__cta { margin-top: 2rem; }

  @media (max-width: 620px) {
    .about__lead { grid-template-columns: 1fr; }
    .about__portrait { width: 7rem; }
  }
  .about__portrait { overflow: hidden; }
  .about__portrait img { width: 100%; height: 100%; object-fit: cover; display: block; }
</style>
