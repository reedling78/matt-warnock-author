# Copy to functions/.env and fill in. Non-secret config only.
# Secrets (SMTP_USER, SMTP_PASS) are set separately with:
#   firebase functions:secrets:set SMTP_USER
#   firebase functions:secrets:set SMTP_PASS
#
# CONTACT_FROM must be the SAME address as SMTP_USER when sending via Gmail --
# Gmail will not send as an address it does not own.

SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
CONTACT_TO=mwarnockauthor@gmail.com
CONTACT_FROM=Matt Warnock Site <mwarnockauthor@gmail.com>
